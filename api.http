@baseUrl = http://localhost:3333

### Check API health
GET {{baseUrl}}/healthz

### Create an event
# @name createEvent
POST {{baseUrl}}/events
Content-Type: application/json

{
  "title": "Community meetup {{$timestamp}}",
  "details": "A local event for the pass.in demo",
  "maximumAttendees": 20
}

### Register an attendee
@eventId = {{createEvent.response.body.$.eventId}}
# @name registerAttendee
POST {{baseUrl}}/events/{{eventId}}/attendees
Content-Type: application/json

{
  "name": "Alex Rivera",
  "email": "alex@example.com"
}

### Get the event
GET {{baseUrl}}/events/{{eventId}}

### Get the attendee badge
@attendeeId = {{registerAttendee.response.body.$.attendeeId}}
# @name getBadge
GET {{baseUrl}}/attendees/{{attendeeId}}/badge

### Check in the attendee using the badge URL
GET {{getBadge.response.body.$.badge.checkInURL}}

### List the event's attendees
GET {{baseUrl}}/events/{{eventId}}/attendees?query=Alex&pageIndex=0
